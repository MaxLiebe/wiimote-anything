# Reference only: ESP-IDF does not apply a component's sdkconfig.defaults to
# the project. Copy what you need into your project's sdkconfig.defaults.

# --- BTstack backend (also with Bluepad32) ---------------------------------
# BTstack is the host; the IDF supplies only the controller. BTstack's ESP32
# port builds its Classic sources only in dual mode, so use BTDM.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BTDM_CTRL_MODEM_SLEEP=n
CONFIG_FREERTOS_HZ=1000

# --- Bluedroid backend (fallback) ------------------------------------------
# CONFIG_BT_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED=y
# CONFIG_BT_CLASSIC_ENABLED=y
# CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
# CONFIG_BT_L2CAP_ENABLED=y
# CONFIG_BT_SDP_COMMON_ENABLED=y
