# Default Bluetooth configuration for BTstack / Bluepad32 on original ESP32
# BTstack runs in controller-only VHCI mode with Bluedroid disabled.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_CONTROLLER_ONLY=y

# If building with the legacy Bluedroid backend instead, uncomment these:
# CONFIG_BT_BLUEDROID_ENABLED=y
# CONFIG_BT_CLASSIC_ENABLED=y
# CONFIG_BT_L2CAP_ENABLED=y
# CONFIG_BT_SDP_COMMON_ENABLED=y
# CONFIG_BT_CONTROLLER_ONLY=n
