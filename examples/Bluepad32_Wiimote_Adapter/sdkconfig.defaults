# Bluepad32 -> Wii adapter (original ESP32 only)

CONFIG_IDF_TARGET="esp32"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP32_XTAL_FREQ_AUTO=y
CONFIG_XTAL_FREQ_AUTO=y

# Bluetooth controller only (BTstack is the host). BTstack's ESP32 port only
# builds its Classic sources in dual mode, so keep BTDM even without BLE.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
# Gamepad + Wii + one spare for a gamepad that is being replaced.
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=4
CONFIG_BTDM_CTRL_BLE_MAX_CONN=3
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=0
CONFIG_BTDM_CTRL_AUTO_LATENCY=y
CONFIG_BTDM_CTRL_MODEM_SLEEP=n

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# 1 ms ticks: the 5 ms report timer and the 20 ms housekeeping tick need them.
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# Bluepad32
CONFIG_BLUEPAD32_PLATFORM_CUSTOM=y
CONFIG_BLUEPAD32_MAX_DEVICES=2
# Classic gamepads only by default (see ADAPTER_ENABLE_BLE in main.c).
# CONFIG_BLUEPAD32_ENABLE_BLE_BY_DEFAULT is not set

# BTstack
CONFIG_BTSTACK_AUDIO=n

# Faster CPU: less time from gamepad report to Wii report.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
